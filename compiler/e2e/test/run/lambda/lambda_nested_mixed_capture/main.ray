def main() -> int32:
    let mut value = 32
    let mut other = 0
    # The inner closures borrow `main`'s `value` and `other` through `outer`:
    # the reader immutably, the writer mutably.
    let outer = () -> (() -> value, () -> other = 10)
    let callbacks = outer()
    callbacks.1()
    let read = callbacks.0()
    return read + other
