eff Ask:
    def ask(value: int32) -> int32


# `Ask` is both handled by the `run` and performed by `body`. The body's `Ask`
# reaches the clause, and the clause's `Ask` leaves `body`.
def body() -> int32 \ {Ask}:
    let before = Ask.ask(1)
    let inner = run:
        return Ask.ask(10)
    with Ask:
        def ask(value):
            return Ask.ask(value + 1) + 100
    return before + inner


def drive(k: core.Continuation[r, c], value: r) given (co: core.Coroutine[c]) -> int32 where (co.Return = int32, co.Effect = {Ask}):
    return handle k(value):
        case Ask.ask(value) resume next: drive(next, value * 2)


# before = 2; inner = ask(11) + 100 = 22 + 100 = 122; 2 + 122 = 124
def main() -> int32:
    return drive(coro body(), ())
