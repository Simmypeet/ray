pub extern def printf(format: cstr, ...) -> c_int


def trace(depth: int32) -> int32:
    printf("ask %d\n", depth)
    return depth


eff Ask:
    def ask(depth: int32) -> int32


# The frame of each call holds the frame of the next call, so `sum` would hold
# its own frame. `value` is held across the recursive call.
def sum(n: int32) -> int32 \ {Ask}:
    if n == 0:
        return 0
    let value = Ask.ask(n)
    return value + sum(n - 1)


def drive(k: core.Continuation[r, c], value: r) given (co: core.Coroutine[c]) -> int32 where (co.Return = int32, co.Effect = {Ask}):
    return handle k(value):
        case Ask.ask(depth) resume next: drive(next, trace(depth) * 10)


# 30 + 20 + 10 = 60
def main() -> int32:
    printf("result %d\n", drive(coro sum(3), ()))
    return 0
