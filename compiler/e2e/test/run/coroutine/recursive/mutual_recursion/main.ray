pub extern def printf(format: cstr, ...) -> c_int


def trace(n: int32) -> int32:
    printf("ask %d\n", n)
    return n


eff Ask:
    def ask(n: int32) -> int32


# `even` holds the frame of `odd`, which holds the frame of `even`. Boxing
# either call breaks the cycle.
def even(n: int32) -> int32 \ {Ask}:
    let value = Ask.ask(n)
    if n == 0:
        return value
    return value + odd(n - 1)


def odd(n: int32) -> int32 \ {Ask}:
    let value = Ask.ask(n)
    if n == 0:
        return value
    return value + even(n - 1)


def drive(k: core.Continuation[r, c], value: r) given (co: core.Coroutine[c]) -> int32 where (co.Return = int32, co.Effect = {Ask}):
    return handle k(value):
        case Ask.ask(n) resume next: drive(next, trace(n))


# 5 + 4 + 3 + 2 + 1 + 0 = 15
def main() -> int32:
    printf("result %d\n", drive(coro even(5), ()))
    return 0
