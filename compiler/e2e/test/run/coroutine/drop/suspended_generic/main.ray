pub extern def printf(format: cstr, ...) -> c_int


pub struct Noisy:
    pub value: int32

impl !core.Copy for Noisy

inst NoisyDrop for core.Drop[Noisy]:
    def drop(self: Noisy):
        printf("drop %d\n", self.value)
        core.NoDrop { value = move self }


eff Ask:
    def ask() -> int32


def abandoned() -> int32:
    printf("abandoned\n")
    return 0


# Answers the first `Ask` by dropping the continuation, so the coroutine stays
# suspended there until its storage ends.
def abandon(k: core.Continuation[r, c], value: r) given (co: core.Coroutine[c], _: core.Drop[c]) -> int32 where (co.Return = int32, co.Effect = {Ask}):
    return handle k(value):
        case Ask.ask() resume _: abandoned()


# `value` is held across the `perform`. Dropping the frame there drops it with
# the coroutine's own `Drop[t]`, which is the one of `Noisy` once `hold` is
# instantiated.
def hold[t](value: t) given (_: core.Drop[t]) -> int32 \ {Ask}:
    let answer = Ask.ask()
    return answer


def create[t](value: t) given (_: core.Drop[t]):
    if true:
        let result = abandon(coro hold(value), ())
        printf("result %d\n", result)
    printf("after scope\n")


def main() -> int32:
    create(Noisy { value = 1 })
    return 0
