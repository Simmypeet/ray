pub extern def printf(format: cstr, ...) -> c_int


pub struct Noisy:
    pub value: int32

impl !core.Copy for Noisy

inst NoisyDrop for core.Drop[Noisy]:
    def drop(self: Noisy):
        printf("drop %d\n", self.value)
        core.NoDrop { value = move self }


eff Ask:
    def ask() -> int32


eff Tell:
    def tell() -> int32


def abandoned() -> int32:
    printf("abandoned\n")
    return 0


# Answers the first `Ask` by dropping the continuation, so the coroutine stays
# suspended there until its storage ends.
def abandon(k: core.Continuation[r, c], value: r) given (co: core.Coroutine[c], _: core.Drop[c]) -> int32 where (co.Return = int32, co.Effect = {Ask}):
    return handle k(value):
        case Ask.ask() resume _: abandoned()


def inner(value: Noisy) -> int32 \ {Ask, Tell}:
    return value.value + Ask.ask()


# `outer` handles `Tell` and forwards `Ask`, so it is suspended at the `handle`
# while `inner` is suspended at its `perform`. The `handle` only holds the
# continuation, which points to the storage of `inner` in the frame of `outer`.
# Dropping the frame of `outer` drops that storage, so `inner` drops its value,
# and then `outer` drops its own.
def outer() -> int32 \ {Ask}:
    let mine = Noisy { value = 1 }
    let k = coro inner(Noisy { value = 2 })
    let result = handle k():
        case Tell.tell() resume _: 0
    return result + mine.value


def main() -> int32:
    if true:
        let result = abandon(coro outer(), ())
        printf("result %d\n", result)
    printf("after scope\n")
    return 0
