pub extern def printf(format: cstr, ...) -> c_int


pub struct Noisy:
    pub value: int32

impl !core.Copy for Noisy

inst NoisyDrop for core.Drop[Noisy]:
    def drop(self: Noisy):
        printf("drop %d\n", self.value)
        core.NoDrop { value = move self }


eff Ask:
    def ask() -> int32


def abandoned() -> int32:
    printf("abandoned\n")
    return 0


# Answers the first `Ask` by dropping the continuation, so the coroutine stays
# suspended there until its storage ends.
def abandon(k: core.Continuation[r, c], value: r) given (co: core.Coroutine[c], _: core.Drop[c]) -> int32 where (co.Return = int32, co.Effect = {Ask}):
    return handle k(value):
        case Ask.ask() resume _: abandoned()


def consume(first: Noisy, second: Noisy) -> int32:
    return first.value + second.value


def suspend(callable: f) given (d: core.Def[f], _: core.Drop[f]) where (d.Args = (Noisy,), d.Return = int32, d.Effect = {Ask}):
    if true:
        let result = abandon(coro d.call(callable, (Noisy { value = 2 },)), ())
        printf("result %d\n", result)
    printf("after scope\n")


# The closure suspends before it consumes anything, so it still owns its
# capture and its argument. Dropping its frame drops the argument, then the
# capture, as when the closure returns.
def main() -> int32:
    let captured = Noisy { value = 1 }
    suspend((argument) -> Ask.ask() + consume(move captured, argument))
    return 0
