eff Ask:
    def ask(value: int32) -> int32


eff Wide:
    def wide() -> int64


def body() -> int32 \ {Ask}:
    return Ask.ask(1) + Ask.ask(2)


# The continuation forwards `Ask` in a body that also performs `Wide` itself, so
# what it is resumed with converts between the rows on the way in.
def finish(k: core.Continuation[r, c], value: r) given (co: core.Coroutine[c]) -> int32 \ {Ask, Wide} where (co.Return = int32, co.Effect = {Ask}):
    let total = k(value)
    let wide = Wide.wide()
    if wide == 9:
        return total
    return 0


def drive(k: core.Continuation[r, c], value: r) given (co: core.Coroutine[c]) -> int32 where (co.Return = int32, co.Effect = {Ask, Wide}):
    return handle k(value):
        case Ask.ask(value) resume next: drive(next, value + 10)
        case Wide.wide() resume next: drive(next, 9)


# (1 + 10) + (2 + 10) = 23
def main() -> int32:
    return drive(coro finish(coro body(), ()), ())
