eff Ask:
    def ask() -> int32


# The callee is known only once the instance of `Def` is: a closure, whose
# capture and argument are stored in a frame nested in this one.
def callIt(callable: f) given (d: core.Def[f], _: core.Drop[f]) -> int32 \ {Ask} where (d.Args = (int32,), d.Return = int32, d.Effect = {Ask}):
    return d.call(callable, (2,)) + Ask.ask()


def drive(k: core.Continuation[r, c], value: r, n: int32) given (co: core.Coroutine[c]) -> int32 where (co.Return = int32, co.Effect = {Ask}):
    return handle k(value):
        case Ask.ask() resume next: drive(next, n, n * 2)


def main() -> int32:
    let captured = 10
    return drive(coro callIt((argument) -> captured + argument + Ask.ask()), (), 5)
