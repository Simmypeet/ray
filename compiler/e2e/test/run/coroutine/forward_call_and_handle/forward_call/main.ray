eff Ask:
    def ask(value: int32) -> int32


def askTwice(base: int32) -> int32 \ {Ask}:
    let first = Ask.ask(base)
    return first + Ask.ask(first)


# The callee runs in a frame stored in the frame of `outer`, which holds `before`
# across the call. Both have the same row and return type, so what the callee
# yields is returned as it is.
def outer() -> int32 \ {Ask}:
    let before = Ask.ask(1)
    let middle = askTwice(before)
    return before + middle


def drive(k: core.Continuation[r, c], value: r) given (co: core.Coroutine[c]) -> int32 where (co.Return = int32, co.Effect = {Ask}):
    return handle k(value):
        case Ask.ask(value) resume next: drive(next, value * 2)


# before = 2; first = 4; second = 8; middle = 12; 2 + 12 = 14
def main() -> int32:
    return drive(coro outer(), ())
