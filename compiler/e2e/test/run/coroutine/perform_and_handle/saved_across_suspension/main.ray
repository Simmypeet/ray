eff Ask:
    def ask(step: int32) -> int32


# The parameter, the variables and the borrowed variable must all survive the
# suspensions, in whatever part of the frame they end up.
def compute(base: int32) -> int32 \ {Ask}:
    let first = Ask.ask(base)
    let mut total = base + first
    let reference = total.&mut
    let second = Ask.ask(first)
    reference.* = reference.* + second
    let third = Ask.ask(second)
    return total + third


def drive(k: core.Continuation[r, c], value: r, seen: int32) given (co: core.Coroutine[c]) -> int32 where (co.Return = int32, co.Effect = {Ask}):
    return handle k(value):
        case Ask.ask(step) resume next: drive(next, step + 1, seen + step)
        case return result: result + seen


# Asks see 1, 2 and 3. The result is (1 + 2 + 3 + 4) + 6.
def main() -> int32:
    return drive(coro compute(1), (), 0)
