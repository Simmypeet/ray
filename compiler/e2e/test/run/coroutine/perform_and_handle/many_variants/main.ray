# The handler resumes the coroutine in a loop rather than recursing once per
# operation, so the stack stays flat across all 260 suspensions.
def main() -> int32:
    let mut con = coro script()
    let mut total = 0

    while true:
        handle con(()):
            case Many.op0() resume next:
                total = total + 1
                con = next
            case Many.op1() resume next:
                total = total + 1
                con = next
            case Many.op2() resume next:
                total = total + 1
                con = next
