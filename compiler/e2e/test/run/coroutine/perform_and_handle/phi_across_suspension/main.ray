eff Ask:
    def ask(value: int32) -> int32


# The value of the `if` merges two blocks that each resume from a suspension,
# and the loop writes the same variable before and after suspending.
def script(flag: bool) -> int32 \ {Ask}:
    let picked = if flag: Ask.ask(1) else: Ask.ask(2)

    let mut index = 0
    let mut sum = picked
    while index != 3:
        sum = sum + Ask.ask(index)
        index = index + 1

    return sum


def drive(k: core.Continuation[r, c], value: r) given (co: core.Coroutine[c]) -> int32 where (co.Return = int32, co.Effect = {Ask}):
    return handle k(value):
        case Ask.ask(value) resume next: drive(next, value * 10)


# 20 + 0 + 10 + 20 = 50, and 10 + 0 + 10 + 20 = 40.
def main() -> int32:
    return drive(coro script(false), ()) - drive(coro script(true), ()) + 32
