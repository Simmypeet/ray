def invoke(value: f, args: d.Args) given (d: core.Def[f]) -> d.Return \ d.Effect:
    return d.call(value, args)

def main() -> int32:
    # The inner closure outlives `outer`'s call, so it takes `x` by value.
    let outer = (x) -> (() -> move x)
    let inner = invoke(outer, (42,))
    return invoke(inner, ())
