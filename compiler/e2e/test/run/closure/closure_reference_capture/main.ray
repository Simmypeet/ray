def invoke(value: f, args: d.Args) given (d: core.Def[f]) -> d.Return \ d.Effect:
    return d.call(value, args)

def main() -> int32:
    let mut value = 1

    # Both closures capture `value` by `&mut`, so each updates the original.
    # A closure holding a `&mut` capture is not `Copy`, so each is invoked
    # once.
    let update = () -> value = value + 10
    invoke(update, ())
    let again = () -> value = value + 10
    invoke(again, ())
    return value
