def invoke(value: f, args: d.Args) given (d: core.Def[f]) -> d.Return \ d.Effect:
    return d.call(value, args)

def main() -> int32:
    let mut value = 32
    # `move` snapshots `value`, so the later assignment is not observed.
    let closure = () -> move value
    value = 42
    return invoke(closure, ())
