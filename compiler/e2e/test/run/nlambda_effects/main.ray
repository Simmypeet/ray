def invoke(value: f, args: d.Args) given (d: core.Def[f]) -> d.Return \ d.Effect:
    return d.call(value, args)

eff Identity[t]:
    def apply(value: t) -> t

def call(value: f) given (d: core.Def[f]) -> int32 \ {Identity[int32]} where (d.Args = (), d.Return = int32, d.Effect = {Identity[int32]}):
    return invoke(value, ())

def main() -> int32:
    let closure = [] -> Identity[int32].apply(1)
    let first = run:
        return call(closure)
    with Identity[int32]:
        def apply(value):
            return value + 9
    let second = run:
        return call(closure)
    with Identity[int32]:
        def apply(value):
            return value + 31
    return first + second
