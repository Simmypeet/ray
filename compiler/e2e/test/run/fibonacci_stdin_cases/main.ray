extern def scanf(format: cstr, ...) -> c_int
extern def printf(format: cstr, ...) -> c_int

def fibonacci(value: c_int) -> c_int:
    return if value == 0: 0 else: if value == 1: 1 else: fibonacci(value - 1) + fibonacci(value - 2)

def main() -> int32:
    let mut value: c_int = 0
    scanf("%d", value.&mut)

    printf("fibonacci(%d) = %d\n", value, fibonacci(value))
    return 0
