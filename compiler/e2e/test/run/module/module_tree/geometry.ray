# The submodules of `geometry` live in the `geometry` directory.
pub module shapes

pub struct Point:
    pub x: int32
    pub y: int32

pub def describe() -> cstr:
    return "geometry"

pub def manhattan(point: Point) -> int32:
    # Items of the same module are named without a prefix.
    return sum(point.x, point.y)

def sum(first: int32, second: int32) -> int32:
    return first + second
