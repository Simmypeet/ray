trait Container[a]:
    type Item[b]
    def identity(value: this.Item[b]) -> this.Item[b]

inst Concrete[a] for Container[a]:
    type Item[b] = (a, b)
    def identity(value: (a, b)) -> (a, b):
        return value

def generic(value: i.Item[b]) given (i: Container[int32]) -> i.Item[b]:
    return i.identity(value)

def main() -> int32:
    let value: Concrete[int32].Item[bool] = (42, true)
    let result = generic[given Concrete[int32]](Concrete[int32].identity(value))
    return if value.1 and result.1: result.0 else: 1
