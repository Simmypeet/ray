extern def printf(format: cstr, ...) -> c_int


struct Logged:
    value: int32


impl !core.Copy for Logged


inst LoggedDrop for core.Drop[Logged]:
    def drop(self: Logged):
        printf("drop %d\n", self.value)
        core.NoDrop { value = move self }


enum Maybe[t]:
    Some(t)
    Nothing


# Only the payload of the variant a value holds is dropped.
enum Either:
    Left(Logged)
    Right((Logged, Logged))
    Neither


# A value of a list holds a raw pointer to the rest, which it does not own.
enum List:
    Cons((Logged, *List))
    Nil


# An enum in a struct is dropped by the struct's drop.
struct Holder:
    first: Maybe[Logged]
    second: Either


eff Ask:
    def ask(value: int32)


def wrap(value: t) -> Maybe[t]:
    return Maybe.Some(move value)


def pick(left: bool) -> Either:
    if left:
        return Either.Left(Logged { value = 20 })

    return Either.Right((Logged { value = 21 }, Logged { value = 22 }))


# The enum is kept in the frame across the suspension.
def asks() -> int32 \ {Ask}:
    let kept = wrap(Logged { value = 40 })
    Ask.ask(1)
    return 2


def drive(k: core.Continuation[r, c], value: r) given (co: core.Coroutine[c]) -> int32 where (co.Return = int32, co.Effect = {Ask}):
    return handle k(value):
        case Ask.ask(value) resume next: drive(next, ())
        case return result: result


def main() -> int32:
    # dropped in reverse order of declaration
    let some = wrap(Logged { value = 1 })
    let nothing: Maybe[Logged] = Maybe.Nothing
    let nested = wrap(wrap(Logged { value = 2 }))

    printf("either\n")
    let left = pick(true)
    let right = pick(false)
    let neither = Either.Neither

    printf("list\n")
    let nil = List.Nil
    let tail: *List = nil.&
    let list = List.Cons((Logged { value = 30 }, tail))

    printf("holder\n")
    let holder = Holder { first = wrap(Logged { value = 31 }), second = Either.Neither }

    printf("coroutine\n")
    let driven = drive(coro asks(), ())

    printf("end\n")
    return driven
