extern def puts(message: cstr) -> c_int

struct Logged:
    message: cstr

inst LoggedDrop for core.Drop[Logged]:
    def drop(self: Logged):
        puts(self.message)

        # Consume `self` without dropping it again.
        core.NoDrop { value = move self }

# `Box[a]` needs an external `Drop[a]`. Inside `disposeBox`, `a` is opaque,
# so the lexical dictionary fills it and must reach the generated body.
struct Box[a]:
    value: a

def dispose(value: a) given (drop: core.Drop[a]):
    drop.drop(value)

def disposeBox(value: Box[a]) given (drop: core.Drop[a]):
    dispose(value)

def main() -> int32:
    disposeBox(Box { value = Logged { message = "boxed" } })
    return 0
