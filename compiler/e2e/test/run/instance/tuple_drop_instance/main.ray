extern def puts(message: cstr) -> c_int

struct Logged:
    message: cstr

inst LoggedDrop for core.Drop[Logged]:
    def drop(self: Logged):
        puts(self.message)

def dispose(value: a) given (drop: core.Drop[a]):
    drop.drop(value)

# The tuple Drop is built-in; the opaque element `a` uses the lexical
# dictionary, and `bool` stays a no-op.
def disposePair(value: (a, bool)) given (drop: core.Drop[a]):
    dispose(value)

def disposeNested(value: (a, (b, c, d), e)) given (
    firstDrop: core.Drop[a],
    secondDrop: core.Drop[b],
    thirdDrop: core.Drop[c],
    fourthDrop: core.Drop[d],
    fifthDrop: core.Drop[e],
):
    dispose(value)

def main() -> int32:
    disposePair((Logged { message = "pair" }, true))
    disposeNested((
        Logged { message = "first" },
        (
            Logged { message = "second" },
            Logged { message = "third" },
            Logged { message = "fourth" },
        ),
        Logged { message = "fifth" },
    ))
    return 0
