extern def puts(message: cstr) -> c_int

struct Logged:
    message: cstr

inst LoggedDrop for core.Drop[Logged]:
    def drop(self: Logged):
        puts(self.message)

inst OverrideDrop[a] for core.Drop[a]:
    def drop(self: a):
        puts("lexical override")

def dispose(value: a) given (drop: core.Drop[a]):
    drop.drop(value)

def disposeInt(value: int32) given (drop: core.Drop[int32]):
    dispose(value)

def disposePair(value: (int32, bool)) given (drop: core.Drop[(int32, bool)]):
    dispose(value)

def disposeNested(value: (a, (b, c, d), e)) given (
    firstDrop: core.Drop[a],
    secondDrop: core.Drop[b],
    thirdDrop: core.Drop[c],
    fourthDrop: core.Drop[d],
    fifthDrop: core.Drop[e],
):
    dispose(value)

def main() -> int32:
    disposeInt[given OverrideDrop[int32]](42)
    disposePair[given OverrideDrop[(int32, bool)]]((1, true))
    disposeNested((
        Logged { message = "first" },
        (
            Logged { message = "second" },
            Logged { message = "third" },
            Logged { message = "fourth" },
        ),
        Logged { message = "fifth" },
    ))
    return 0
