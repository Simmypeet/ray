extern def puts(message: cstr) -> c_int

struct Logged:
    message: cstr

inst LoggedDrop for core.Drop[Logged]:
    def drop(self: Logged):
        puts(self.message)

        # Consume `self` without dropping it again.
        core.NoDrop { value = move self }

def make(message: cstr) -> Logged:
    return Logged { message = message }

def dispose(value: a) given (drop: core.Drop[a]):
    drop.drop(value)

# The polymorphic capture is dropped with the dictionary supplied by the caller.
def discardCapture(value: a) given (drop: core.Drop[a]):
    () -> value

def main() -> int32:
    # A discarded closure drops its by-value captures in reverse order.
    # `Logged` is `Copy`, so `move` keeps the captures from also being
    # dropped here.
    let first = make("value.first")
    let second = make("value.second")
    () -> (move first, move second)

    # A borrowed capture is a reference in the environment, so only the
    # by-value capture is dropped. `borrowed` itself is dropped when `main`
    # returns.
    let owned = make("owned")
    let borrowed = make("borrowed")
    () -> (move owned, borrowed.&)

    discardCapture(make("poly"))

    # A closure passed as a polymorphic value resolves `Drop` at the call site.
    let passed = make("passed")
    dispose(() -> move passed)

    puts("end")
    return 0
