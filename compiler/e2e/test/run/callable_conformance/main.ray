trait Marker[a]:
    def value(x: a) -> a

trait Callers[t]:
    def invoke(left: f, right: g, value: a, outer: t) given (first: core.Def[f], m: Marker[a], second: core.Def[g]) -> int32 where (first.Args = (a,), second.Args = (a,), first.Return = int32, second.Return = int32, first.Effect = {}, second.Effect = {})

inst Renamed for Callers[int32]:
    def invoke(left: f, right: g, value: x, outer: int32) given (first: core.Def[f], evidence: Marker[x], second: core.Def[g]) -> int32 where (first.Args = (x,), second.Args = (x,), first.Return = int32, second.Return = int32, first.Effect = {}, second.Effect = {}):
        return right(value)

inst Explicit for Callers[bool]:
    def invoke(left: f, right: g, value: a, outer: bool) given (first: core.Def[f], evidence: Marker[a], second: core.Def[g]) -> int32 where (first.Args = (a,), second.Args = (a,), first.Return = int32, second.Return = int32, first.Effect = {}, second.Effect = {}):
        return first.call(left, (value,))

trait ExplicitContract[t]:
    def invoke(fn: f, value: a) given (d: core.Def[f]) -> int32 where (d.Args = (a,), d.Return = int32, d.Effect = {})

inst ExplicitEquivalent for ExplicitContract[int32]:
    def invoke(fn: f, value: a) given (d: core.Def[f]) -> int32 where (d.Args = (a,), d.Return = int32, d.Effect = {}):
        return fn(value)

inst IntEvidence for Marker[int32]:
    def value(x: int32) -> int32:
        return x

def main() -> int32:
    let first = Explicit.invoke((x) -> x + 1, (x) -> x + 2, 20, true)
    return first + ExplicitEquivalent.invoke((x) -> x + 1, 20)
