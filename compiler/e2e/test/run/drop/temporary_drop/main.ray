extern def printf(str: cstr, ...) -> c_int
extern def scanf(str: cstr, ...) -> c_int


pub struct Temporary:
    pub value: int32


pub inst TempDrop for core.Drop[Temporary]:
    def drop(temp: Temporary):
        printf("dropTemporary(%d)\n", temp.value)
        core.NoDrop { value = move temp }


pub def makeTemporary(a: int32) -> Temporary:
    printf("makeTemporary(%d)\n", a)
    return Temporary { value = a }


pub def printTemporary(temp: Temporary, value: ()):
    printf("printTemporary(%d)\n", temp.value)


pub def main() -> int32:
    let mut input: int32 = 0
    scanf("%d", input.&mut)

    printTemporary(
        makeTemporary(1), 
        if input != 0:
            return 0
        else:
            ()
    )

    return 0