eff Scope:
    def current() -> int32

extern def printf(format: cstr, ...) -> c_int

def readScope() -> int32 \ {Scope}:
    return Scope.current()

def forwardScope() -> int32 \ {Scope}:
    return readScope()

def invoke(callback: def() -> int32 \ {Scope}) -> int32 \ {Scope}:
    return callback()

def main() -> int32:
    let result = run:
        let callback = [] -> forwardScope()
        
        let outerBefore = invoke(callback)
        let inner = run:
            return invoke(callback)
        with Scope:
            def current():
                return 20
        let outerAfter = invoke(callback)
        printf("outer-before = %d, inner = %d, outer-after = %d\n", outerBefore, inner, outerAfter)
        return 0
    with Scope:
        def current():
            return 1

    return result
