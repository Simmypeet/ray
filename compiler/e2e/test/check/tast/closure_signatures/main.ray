def zero(callback: def()):
    return callback()

def omitted(callback: def(int32)):
    return callback(1)

def explicit(callback: def(int32, bool,) -> float32) -> float32:
    return callback(1, true)

def polymorphic(callback: def(a, b) -> b, value: a, other: b) -> b:
    return callback(value, other)
