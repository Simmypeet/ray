trait Eq[a]:
    def equals(lhs: a, rhs: a) -> bool

trait Ord[a]:
    def less(lhs: a, rhs: a) -> bool

inst EqInt for Eq[int32]:
    def equals(lhs: int32, rhs: int32) -> bool:
        return lhs == rhs

inst EqBool for Eq[bool]:
    def equals(lhs: bool, rhs: bool) -> bool:
        return lhs == rhs

inst OrdBool for Ord[bool]:
    def less(lhs: bool, rhs: bool) -> bool:
        return false

def accepts(value: a) given (equality: Eq[a], drop: core.Drop[a]) -> bool:
    return true

def wrongTrait(value: int32) -> bool:
    return accepts[given OrdBool](value)

def wrongType(value: int32) -> bool:
    return accepts[given equality = EqBool](value)

def wrongPolyVar(value: a) given (ordering: Ord[a], drop: core.Drop[a]) -> bool:
    return accepts[given ordering](value)

def valid(value: int32) -> bool:
    return accepts[given EqInt](value)

def validPolyVar(value: a) given (equality: Eq[a], drop: core.Drop[a]) -> bool:
    return accepts[given equality](value)

inst GenericEq[a] for Eq[a]:
    def equals(lhs: a, rhs: a) -> bool:
        core.NoDrop { value = (move lhs, move rhs) }
        return true

def generic(value: int32) -> bool:
    return accepts[given GenericEq[int32]](value)

def genericMismatch(value: int32) -> bool:
    return accepts[given GenericEq[bool]](value)

trait Member[a]:
    def check() given (equality: Eq[a]) -> bool

inst IntMember for Member[int32]:
    def check() given (equality: Eq[int32]) -> bool:
        return true

def validInstanceMember() -> bool:
    return IntMember.check[given EqInt]()

def invalidInstanceMember() -> bool:
    return IntMember.check[given EqBool]()

def validPolyVarMember() given (member: Member[int32]) -> bool:
    return member.check[given EqInt]()

def invalidPolyVarMember() given (member: Member[int32]) -> bool:
    return member.check[given EqBool]()

eff Reader[a] given (equality: Eq[a]):
    def read() -> a

def requireBool(callback: def() -> () \ {Reader[int32; given EqBool]}):
    return ()

def badLocal(callback: def() -> () \ {Reader[int32; given EqInt]}) -> ():
    requireBool(callback)
    return ()

def validLiteral() -> bool:
    return accepts[given EqInt](1)

def inferredGeneric(value: int32) -> bool:
    return accepts[given GenericEq](value)
