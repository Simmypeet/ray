trait Eq[a]:
    def equals(lhs: a, rhs: a) -> bool

inst GenericEq[a] for Eq[a]:
    def equals(lhs: a, rhs: a) -> bool:
        return true

eff Reader[a] given (equality: Eq[a]):
    def read() -> a

def mismatch(callback: def() -> () \ {Reader[int32] given (GenericEq[int32])}) -> ():
    let local: def() -> () \ {Reader[bool] given (GenericEq[bool])} = callback
    return ()
