eff State[s]:
    def get() -> s


def withIntState() -> () \ {State[int32]}:
    return ()


def mismatchedTopLevel() -> ():
    return withIntState()


def matchingTopLevel() -> () \ {State[int32]}:
    return withIntState()


def requirePure(callback: def()):
    return ()

def requireState(callback: def() \ {State[int32]}):
    return ()

def mismatchedClosure() -> ():
    requirePure(() -> withIntState())
    return ()


def matchingClosure() -> ():
    requireState(() -> withIntState())
    return ()
