 1 │ # The `Drop` of a tuple is built from the `Drop` of each element, so the
 2 │ # error names the element that cannot be dropped.
 3 │
 4 │ @linear
 5 │ struct Handle:
 6 │     fd: int32
 7 │
 8 │ def make() -> Handle:
 9 │     return Handle { fd = 0 }
10 │
11 │ # ERROR: the second element of the tuple is linear.
12 │ def leak():
13 │     let pair = (1, make())
   │         ^^^^
   ┆ [error]: no implicit instance found: `core.Drop[(int32, Handle)]`
   ┆    ╭▸ compiler/e2e/test/check/tast/instance_failure_tuple_drop/main.ray:13:9
