 1 │ # OK: both arms of the `if` leave the loop body, so nothing reaches the end
 2 │ # of the body. The analyses still have to accept the loop.
 3 │ def firstOrSkip(stop: bool) -> int32:
 4 │     let mut count = 0
 5 │
 6 │     while true:
 7 │         count = count + 1
 8 │         if stop:
 9 │             break
10 │         else:
11 │             continue
12 │
13 │     return count
14 │
15 │
16 │ def main() -> int32:
17 │     return firstOrSkip(true)
