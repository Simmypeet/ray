# OK: `'a` is used by a field.
struct Ref['a, t]:
    value: &'a t

# OK: `'a` is used through another struct.
struct Holder['a]:
    inner: Ref['a, int32]

# ERROR: `'b` is never used, even though `'a` is.
struct Extra['a, 'b]:
    value: &'a int32

# ERROR: a lifetime used only in the where clause is unused.
struct WhereOnly['a, t] where (t: 'a):
    value: *t

# ERROR: a recursive struct that mentions `'a` only in its own recursion does
# not use it.
struct List['a]:
    next: *List['a]

# ERROR: mutually recursive structs that only pass `'a` to each other do not
# use it.
struct Even['a]:
    next: *Odd['a]

struct Odd['a]:
    next: *Even['a]

# OK: an unused type parameter is invariant rather than an error.
struct Phantom[t]:
    value: int32

# OK: `'a` is used in an operation's parameter.
eff Log['a]:
    def log(message: &'a int32) -> ()

# OK: `'a` is used in an operation's return type.
eff Reader['a]:
    def get() -> &'a int32

# ERROR: `'a` is not used by any operation.
eff Unused['a]:
    def get() -> int32

def main() -> ():
    return ()
