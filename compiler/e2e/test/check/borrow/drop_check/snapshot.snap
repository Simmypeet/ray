53 │ def guardDirectly():
54 │     let mut value = 1
55 │     let guard = Guard { inner = value.&mut }
56 │     # ERROR: `guard` is dropped at the end of the function, where its `Drop`
57 │     # implementation writes through the borrow.
58 │     value = 2
   │     ^^^^^^^^^
   ┆ [error]: cannot assign to a place because it is borrowed
   ┆    ╭▸ compiler/e2e/test/check/borrow/drop_check/main.ray:58:5
   ┆    │
