 1 │ # Drop check: a value that is only dropped later keeps alive just the borrows
 2 │ # its drop may use.
 3 │
 4 │ # A struct with a declared `Drop` implementation, which may use the memory
 5 │ # behind the reference it holds.
 6 │ struct Guard['a]:
 7 │     inner: &'a mut int32
 8 │
 9 │ inst GuardDrop['a] for core.Drop[Guard['a]]:
10 │     def drop(self: Guard['a]):
11 │         self.inner.* = 0
12 │         core.NoDrop { value = move self }
13 │
14 │ # Structs whose `Drop` is generated from their fields.
15 │ struct Wrapper[t]:
16 │     value: t
17 │
18 │ struct Holding['a]:
19 │     value: &'a int32
20 │
21 │ # A generic struct with a declared `Drop` implementation, which only drops its
22 │ # field.
23 │ struct Tagged[t]:
24 │     value: t
25 │
26 │ inst TaggedDrop[t] for core.Drop[Tagged[t]] given (inner: core.Drop[t]):
27 │     def drop(self: Tagged[t]):
28 │         inner.drop(self.value)
29 │
30 │ struct Pair[t, u]:
31 │     first: t
32 │     second: u
33 │
34 │ def genericWrapperOfReference():
35 │     let mut value = 1
36 │     let wrapper = Wrapper { value = value.& }
37 │     # OK: dropping `wrapper` only drops the reference, which does nothing.
38 │     value = 2
39 │
40 │ def lifetimeStructOfReference():
41 │     let mut value = 1
42 │     let holding = Holding { value = value.& }
43 │     # OK: the generated `Drop` of `Holding` does not use its reference.
44 │     value = 2
