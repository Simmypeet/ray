46 │ def referenceBesideGuard():
47 │     let mut value = 1
48 │     let mut other = 2
49 │     let wrapper = Wrapper { value = (Guard { inner = other.&mut }, value.&) }
50 │     # OK: only the guard's `Drop` runs, and it cannot reach `value`.
51 │     value = 3
