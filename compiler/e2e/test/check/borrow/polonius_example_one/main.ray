def consume(x: t) given(_: core.Drop[t]):
    let _ = x

# only (D) is an error
def main():
    let mut x = 22
    let mut y = 44
    let mut p = x.&  # Loan L0, borrowing `x`
    y = y + 1        # (A) Mutate `y` -- is this ok?
    let mut q = y.&  # Loan L1, borrowing `y`
    if true:
        p = q        # `p` now points at `y`
        x = x + 1    # (B) Mutate `x` -- is this ok?
    else:
        y = y + 1    # (C) Mutate `y` -- is this ok?
    
    y = y + 1        # (D) Mutate `y` -- is this ok?
    consume(p.*)      # use `p` again here