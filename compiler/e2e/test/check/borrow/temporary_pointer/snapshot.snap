 8 │ def reborrowPastStatement():
 9 │     let mut x = 1
10 │     # OK: `unique` borrows the memory behind the temporary pointer, which
11 │     # outlives the statement.
12 │     let unique = identity(x.&mut).*.&mut
13 │     unique.* = 2
