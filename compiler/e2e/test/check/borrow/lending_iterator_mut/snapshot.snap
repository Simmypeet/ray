36 │ inst HoldingIteratorCorrect['a] for LendingIterator[Holding['a]]:
37 │     type Item['x] where ('a: 'x) = &'x mut int32
38 │
39 │     def next(self: &'x mut Holding['a]) -> &'x mut int32 where ('a: 'x):
40 │         # This instead generates this graph
41 │         #
42 │         #  +----------+
43 │         #  |          |
44 │         #  V          |
45 │         # 'x ------> '?r
46 │         #             ^
47 │         #             |
48 │         # 'a ---------+
49 │         #
50 │         # Instead, 'a does flow to 'x, but it's covered by the where clause
51 │         return self.*.hold.*.&mut
