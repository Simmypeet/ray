eff Values['a]:
    def get() -> &'a int32
    def update()

eff Source['a]:
    def get() -> &'a int32

eff Sink['a]:
    def put(value: &'a int32)

eff Counter:
    def tick() -> int32


# The handlers of one `run` share their captures, and each may run many
# times. `update` writes `a`, so the handlers capture it mutably, and `get`
# may not give out a borrow of it: the body could still use that borrow when
# `update` runs.
def returned() -> int32:
    let mut a = 1
    return run:
        let r = Values.get()
        Values.update()
        return r.*
    with Values:
        def get():
            return a.&      # <-- Expect an error here.
        def update():
            a = 40


def returnedShared() -> int32:
    let a = 1
    # OK: no handler writes `a`, so the handlers capture it by a shared
    # reference, which `get` only copies.
    return run:
        let r = Source.get()
        return r.*
    with Source:
        def get():
            return a.&


def returnedThroughReference['a](x: &'a mut int32) -> int32:
    # ERROR: `x` is captured mutably, and the handler reborrows what it
    # points at for longer than one run.
    return run:
        let r = Values.get()
        Values.update()
        return r.*
    with Values:
        def get():
            return x.*.&
        def update():
            x.* = 40


def stored() -> int32:
    let mut a = 1
    let b = 2
    let mut slot = b.&
    run:
        Counter.tick()
        Counter.tick()
    with Counter:
        def tick():
            a = a + 1
            slot = a.&      # <-- Expect an error here: `slot` outlives a run.
            return 0
    return slot.*


def performed['a]() -> () \ {Sink['a]}:
    let mut a = 1
    # ERROR: the handler of `Sink['a]` may keep the borrow of `a` that `tick`
    # passes it, past this function, where `a` is gone.
    run:
        Counter.tick()
    with Counter:
        def tick():
            a = a + 1
            # ERROR: the handler of `Sink['a]` may also keep the borrow past
            # this run of `tick`.
            Sink.put(a.&)
            return 0


def usedWithin() -> int32:
    let mut a = 1
    # OK: the borrow of the capture is only used within one run.
    return run:
        Counter.tick()
        return Counter.tick()
    with Counter:
        def tick():
            let p = a.&mut
            p.* = p.* + 1
            let q = a.&
            return q.*


def main() -> int32:
    return returned() + returnedShared() + stored() + usedWithin()
