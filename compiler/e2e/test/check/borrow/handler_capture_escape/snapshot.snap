 15 │ # The handlers of one `run` share their captures, and each may run many
 16 │ # times. `update` writes `a`, so the handlers capture it mutably, and `get`
 17 │ # may not give out a borrow of it: the body could still use that borrow when
 18 │ # `update` runs.
 19 │ def returned() -> int32:
 20 │     let mut a = 1
 21 │     return run:
 22 │         let r = Values.get()
 23 │         Values.update()
 24 │         return r.*
 25 │     with Values:
 26 │         def get():
 27 │             return a.&      # <-- Expect an error here.
    │                    ^^^
    ┆ [error]: captured variable cannot escape the operation handler
    ┆    ╭▸ compiler/e2e/test/check/borrow/handler_capture_escape/main.ray:27:20
    ┆    │
    ┆ 27 │             return a.&      # <-- Expect an error here.
    ┆    │                    ━━━ this lets a borrow of a captured variable escape the operation handler
    ┆    │
    ┆    ╰ help: an operation handler may run again while the borrow is still in use, so a borrow of what it captures mutably may only be used within the handler
    ┆
 28 │         def update():
 29 │             a = 40
