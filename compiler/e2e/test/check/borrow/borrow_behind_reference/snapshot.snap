 9 │ def repointMutableWhileReborrowed(a: &mut int32, b: &mut int32):
10 │     let mut p = a
11 │     let unique = p.*.&mut
12 │     # OK: the assignment replaces the pointer in `p`, not the memory `unique`
13 │     # points to.
