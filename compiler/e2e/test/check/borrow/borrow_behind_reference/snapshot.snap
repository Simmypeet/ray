25 │ def moveHolderWhileReborrowed(x: &int32):
26 │     let holder = Holder{inner=x}
27 │     let shared = holder.inner.*.&
28 │     # OK: nothing can be done to the memory behind a shared reference that the
29 │     # reborrow forbids, wherever the reference goes.
30 │     let moved = holder
31 │     consume(shared.* + moved.inner.*)
