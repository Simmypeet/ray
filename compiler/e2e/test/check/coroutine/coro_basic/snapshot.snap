28 │ # OK: `coro` runs none of the callee, so `main` performs no effect.
29 │ def main() -> int32:
30 │     # A continuation can be kept in a local, moved and passed down.
31 │     let k = coro numbers()
32 │     let moved = k
33 │     keep(moved)
34 │
35 │     # The arguments are evaluated and stored in the coroutine.
36 │     let counting = coro countTo(pure(3))
37 │
38 │     # A polymorphic function has one coroutine type per instantiation.
39 │     let ints = coro echo(1)
40 │     let bools = coro echo(true)
41 │
42 │     # A function without an effect can be suspended too.
43 │     let plain = coro pure(1)
44 │
45 │     # A continuation that is never bound is dropped with its statement.
46 │     coro numbers()
47 │     return 0
