27 │ # OK: resuming the coroutine runs the method and forwards its effect.
28 │ def resumed[t](source: t) given (s: Source[t], _: core.Drop[t]) -> int32 \ {Yield[int32]}:
29 │     let k = coro s.next(source)
30 │     return k(())
