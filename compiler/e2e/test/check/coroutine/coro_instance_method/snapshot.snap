33 │ # OK: the coroutine is driven by `handle`.
34 │ def driven[t](source: t) given (s: Source[t], _: core.Drop[t]) -> int32:
35 │     let mut total = 0
36 │     let mut k = coro s.next(source)
37 │     while true:
38 │         handle k():
39 │             case Yield.yield(value) resume next:
40 │                 total = total + value
41 │                 k = next
42 │             case return result:
43 │                 return total + result
44 │     return total
