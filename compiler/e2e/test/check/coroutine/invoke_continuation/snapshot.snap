22 │ # OK: invoking a continuation runs the coroutine to completion. It returns
23 │ # what the coroutine returns and performs what the coroutine performs.
24 │ def finish(k: core.Continuation[r, c], value: r) given (co: core.Coroutine[c]) -> co.Return \ co.Effect:
25 │     return k(value)
