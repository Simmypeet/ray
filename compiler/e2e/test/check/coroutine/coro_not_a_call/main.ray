eff Yield[t]:
    def yield(value: t) -> ()


extern def abs(value: c_int) -> c_int


def numbers() -> () \ {Yield[int32]}:
    Yield.yield(1)


# ERROR: a value is not a call.
def value(x: int32):
    coro x


# ERROR: a parenthesized call is not a call.
def parenthesized():
    coro (numbers())


# ERROR: an operation is run by whoever handles it.
def operation():
    coro Yield.yield(1)


# ERROR: an `extern def` has no body to suspend.
def external():
    coro abs(1)


# ERROR: a callable value is called through its `Def` instance.
def callable(numbers: def() -> int32):
    coro numbers()


def main() -> int32:
    return 0
