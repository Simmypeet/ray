11 │ # Runs a stateful coroutine from `state`. Each clause gets a continuation
12 │ # that waits for what its operation returns.
13 │ #
14 │ # OK: `get` is answered with an `int32` and `set` with `()`, so the driver
15 │ # is generic over `r` and recurses.
16 │ def drive(k: core.Continuation[r, c], value: r, state: int32) given (co: core.Coroutine[c]) -> int32 where (co.Return = int32, co.Effect = {State[int32]}):
17 │     return handle k(value):
18 │         case State[int32].get() resume k1: drive(k1, state, state)
19 │         case State[int32].set(value) resume k2: drive(k2, (), value)
