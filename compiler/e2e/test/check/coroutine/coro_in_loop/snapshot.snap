13 │ # OK: the storage belongs to the body of the loop, so it is dropped at the end
14 │ # of every iteration and created again by the next one.
15 │ def everyIteration(mut count: int32):
16 │     while count != 0:
17 │         let k = coro numbers()
18 │         keep(k)
19 │         count = count - 1
