# The `Drop` instance of a struct repeats the struct's marker predicate. A
# coroutine of the function being checked holds saved locals that are not
# known yet, so the predicate is deferred instead of failing the drop.

marker Send

impl['a, t] Send for &'a mut t where (t: Send)
impl['a, t] Send for &'a t     where (t: Send)

struct Guard[t] where (t: Send):
    value: t

inst GuardDrop[t] for core.Drop[Guard[t]] given (inner: core.Drop[t]) where (t: Send):
    def drop(self: Guard[t]):
        inner.drop(self.value)

def spin(value: int32):
    # OK: the guard is dropped at the end of the scope.
    let guard = Guard { value = coro spin(value) }

def main():
    spin(0)
