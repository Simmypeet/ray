 27 │ # OK: the outermost call is the resume, whatever gives the continuation, and
 28 │ # a call without an argument resumes with `()`.
 29 │ def parenthesized():
 30 │     handle (coro numbers())():
 31 │         case Yield.yield(value) resume k:
 32 │             pass
 33 │
 34 │
 35 │ # OK: so does a call with `()`.
 36 │ def explicitUnit():
 37 │     let con = coro numbers()
 38 │     handle con(()):
 39 │         case Yield.yield(value) resume k:
 40 │             pass
