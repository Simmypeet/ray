 86 │ # OK: a clause may handle the continuation it binds.
 87 │ def nested() -> int32:
 88 │     return handle coro numbers():
 89 │         case Yield.yield(first) resume k:
 90 │             return handle k():
 91 │                 case Yield.yield(second): first + second
 92 │                 case return: first
 93 │         case return: 0
