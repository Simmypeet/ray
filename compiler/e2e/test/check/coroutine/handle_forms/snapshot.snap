 43 │ # OK: a clause that does not name the continuation drops it with the clause,
 44 │ # which abandons the coroutine. A return clause may ignore the value.
 45 │ def abandon() -> int32:
 46 │     let con = coro numbers()
 47 │     return handle con():
 48 │         case Yield.yield(value): value
 49 │         case return: 0
