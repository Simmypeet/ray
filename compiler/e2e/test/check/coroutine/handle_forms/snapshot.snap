 70 │ # OK: several effects of one coroutine are handled by one `handle`, and the
 71 │ # return clause may be written anywhere among the others.
 72 │ def twoEffects() -> int32:
 73 │     return handle coro askThenYield():
 74 │         case Ask.ask(): 1
 75 │         case return x: x
 76 │         case Yield.yield(value): value
 77 │
 78 │
 79 │ # OK: an effect without a clause is forwarded, so it stays in the effect of
 80 │ # the function.
 81 │ def forwardYield() -> int32 \ {Yield[int32]}:
 82 │     return handle coro askThenYield():
