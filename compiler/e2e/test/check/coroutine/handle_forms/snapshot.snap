 59 │ # OK: a `handle` is an expression, and its clauses use the enclosing
 60 │ # variables directly.
 61 │ def asValue() -> int32:
 62 │     let base = 10
 63 │     let first = handle coro numbers():
 64 │         case Yield.yield(value): base + value
