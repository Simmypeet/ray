trait Eq[a] given (parent: dictionaries.Provider given (dictionaries.EqInt, fallback = dictionaries.EqInt).Eq[a], fallback: Eq[a]):
    def equals(lhs: a, rhs: a) given (parent: Eq[a]) -> bool

eff Reader[a] given (equality: Eq[a]):
    def read() -> a

inst EqInt for Eq[int32] given (parent: Eq[int32]):
    def equals(lhs: int32, rhs: int32) given (parent: Eq[int32]) -> bool:
        return lhs == rhs

def constrained(value: a) given (equality: Eq[a]) -> a:
    return value

def main() -> int32:
    return 0
