module shapes:
    pub def area(side: int32) -> int32:
        # A private item is accessible within its module...
        return square(side)

    def square(side: int32) -> int32:
        return side * side

    struct Hidden:
        value: int32

    module detail:
        pub def twice(value: int32) -> int32:
            # ...and within the modules nested in it.
            return super.square(value) + super.square(value)

    pub module exposed:
        pub def thrice(value: int32) -> int32:
            return super.detail.twice(value) + value


def unwrap(hidden: shapes.Hidden) -> int32:
    return 0


def main() -> int32:
    let area = shapes.area(2)
    let thrice = shapes.exposed.thrice(2)
    let square = shapes.square(2)
    let twice = shapes.detail.twice(2)
    return area + thrice + square + twice
