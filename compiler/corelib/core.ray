pub trait Def[f]:
    pub type Args
    pub type Return
    pub type Effect: Effect

    pub def call(fn: f, a: this.Args) -> this.Return \ this.Effect


pub marker Copy


impl[t] Copy for *t
impl[t] Copy for *mut t


pub trait Drop[t]:
    pub def drop(self: t)


pub struct NoDrop[t]:
    pub value: t
