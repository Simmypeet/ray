pub trait Def[f]:
    pub type Args
    pub type Return
    pub type Effect: Effect

    pub def call(fn: f, a: this.Args) -> this.Return \ this.Effect


pub marker Copy


impl[t] Copy for *t
impl[t] Copy for *mut t


pub trait Drop[t]:
    pub def drop(self: t)


pub struct NoDrop[t]:
    pub value: t


# The trait of every coroutine type: the anonymous type of a suspended
# function. The compiler provides the instance, for a coroutine type `c` and
# for `&mut c`.
pub trait Coroutine[c]:
    # The type the coroutine completes with.
    pub type Return

    # The effects the coroutine may perform while it runs.
    pub type Effect: Effect


# A suspended coroutine of type `c` that is waiting for a value of type `r`.
# Only the compiler creates one.
pub struct Continuation[r, c]:
    coroutine: c
