# The continuation a `handle` clause binds shows its type.
eff State:
  def get() -> int32
  def set(value: int32) -> ()

def counter() -> int32 \ {State}:
  State.set(State.get() + 1)
  return State.get()

pub def main() -> int32:
  return handle coro counter():
    case State.get() resume k<cursor>: 0
    case State.set(value) resume k: value
    case return result: result
