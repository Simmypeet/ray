# The path of a struct initialization offers what leads to a struct.
module geometry:
  pub struct Point:
    pub x: int32

  pub def side() -> int32:
    return 1

  def hidden() -> int32:
    return 2

  pub module shapes:
    pub struct Square:
      pub size: int32

    pub def peek() -> int32:
      return 0

pub def main():
  let point = geometry.Po<cursor> { x = 1 }
